# ---- R / RStudio session state ----------------------------------------------
# None of this describes the analysis; it describes one person's editor.
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# ---- Knit / render caches ---------------------------------------------------
*_cache/
*_files/
.quarto/
_freeze/
# Quarto's intermediate notebook when it picks the Jupyter engine for a document.
*.quarto_ipynb

# Rendered output. _quarto.yml sets output-dir: docs, and the render workflow
# publishes docs/ to GitHub Pages as a build artifact -- nothing generated is
# committed, so a stale HTML page can never contradict the tracked result
# tables. The two patterns below catch HTML from before output-dir was set, and
# from rendering a single notebook outside the project.
/docs/
tag-seq/code/*.html
/*.html
# The manuscript renders standalone, next to its source.
manuscript/*.html
manuscript/*.docx
# ...except the Word template the manuscript renders with, which is a source file.
!manuscript/reference-manuscript.docx
manuscript/*_files/

# ---- regenerated diagnostics -------------------------------------------------
# Notebook 02 writes the normal and ashr shrinkage tables, the per-gene
# normalised counts and the PCA pairs plot here on every render. They are not
# tracked: the manuscript does not use them directly, and the shrinkage
# estimates reach it through Tables S2 and S3, which are tracked and checked.
tag-seq/DESEQ_output/*/alternatives/

# ---- renv -------------------------------------------------------------------
# renv.lock IS tracked; the library it installs is not.
renv/library/
renv/staging/
renv/local/
renv/python/
renv/sandbox/

# ---- OS ---------------------------------------------------------------------
.DS_Store


/.quarto/
